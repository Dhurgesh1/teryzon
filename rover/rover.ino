  BOARD:
  ESP32-S3 DevKitM-1

  CORE:
  Arduino-ESP32 2.0.17

  WIFI:
  SSID:     TERYZON-ROVER
  PASSWORD: teryzon123
  IP:       192.168.4.1

  HARDWARE:
  - ESP32-S3
  - 1 x L298N
  - 4 motors
  - Servo / linear actuator
  - 1.3" SH1106 OLED
  - Embedded SVG logo

  IMPORTANT:
  - NO LittleFS
  - NO SPIFFS
  - NO data folder
  - SVG is stored directly in firmware

  ============================================================
                       PIN MAPPING
  ============================================================

  OLED:
    SDA = GPIO 8
    SCL = GPIO 9

  L298N:
    ENA = GPIO 15
    IN1 = GPIO 4
    IN2 = GPIO 5

    ENB = GPIO 16
    IN3 = GPIO 6
    IN4 = GPIO 7

  SERVO:
    Signal = GPIO 10

  ============================================================
*/

#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SH110X.h>
#include <ESP32Servo.h>


// ============================================================
// WIFI
// ============================================================

const char* AP_SSID = "TERYZON-ROVER";
const char* AP_PASSWORD = "teryzon123";

IPAddress local_IP(192, 168, 4, 1);
IPAddress gateway(192, 168, 4, 1);
IPAddress subnet(255, 255, 255, 0);


// ============================================================
// OLED
// ============================================================

#define OLED_SDA 8
#define OLED_SCL 9
#define OLED_ADDRESS 0x3C

Adafruit_SH1106G display(128, 64, &Wire, -1);


// ============================================================
// L298N
// ============================================================

#define ENA 15
#define IN1 4
#define IN2 5

#define ENB 16
#define IN3 6
#define IN4 7

#define MOTOR_PWM_FREQ 1000
#define MOTOR_PWM_RESOLUTION 8

#define MOTOR_SPEED 220

#define LEFT_PWM_CHANNEL 0
#define RIGHT_PWM_CHANNEL 1


// ============================================================
// SERVO
// ============================================================

#define SERVO_PIN 10

#define SERVO_UP_ANGLE 160
#define SERVO_DOWN_ANGLE 20

#define SERVO_STEP_DELAY 15

Servo probeServo;

bool servoAvailable = false;

int servoPosition = SERVO_UP_ANGLE;

bool probeMovingDown = false;
bool probeMovingUp = false;

unsigned long lastServoMove = 0;


// ============================================================
// WEB SERVER
// ============================================================

WebServer server(80);


// ============================================================
// MOTOR STATE
// ============================================================

String currentMotor = "STOPPED";


