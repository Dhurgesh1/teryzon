<script>

/* ==========================================================
   THEME SYSTEM
   ========================================================== */

const systemBtn =
  document.getElementById("systemBtn");

const lightBtn =
  document.getElementById("lightBtn");

const darkBtn =
  document.getElementById("darkBtn");


const systemPreference =
  window.matchMedia(
    "(prefers-color-scheme: light)"
  );


function applyTheme(theme){

  let actualTheme = theme;


  if(theme === "system"){

    actualTheme =
      systemPreference.matches
      ? "light"
      : "dark";

  }


  document.documentElement.dataset.theme =
    actualTheme;


  systemBtn.classList.toggle(
    "active",
    theme === "system"
  );


  lightBtn.classList.toggle(
    "active",
    theme === "light"
  );


  darkBtn.classList.toggle(
    "active",
    theme === "dark"
  );


  localStorage.setItem(
    "teryzon-theme",
    theme
  );

}


function getSavedTheme(){

  try{

    return (
      localStorage.getItem(
        "teryzon-theme"
      ) || "system"
    );

  }

  catch(error){

    return "system";

  }

}


systemBtn.addEventListener(
  "click",
  function(){

    applyTheme("system");

  }
);


lightBtn.addEventListener(
  "click",
  function(){

    applyTheme("light");

  }
);


darkBtn.addEventListener(
  "click",
  function(){

    applyTheme("dark");

  }
);


applyTheme(
  getSavedTheme()
);


systemPreference.addEventListener(
  "change",
  function(){

    if(
      getSavedTheme() === "system"
    ){

      applyTheme("system");

    }

  }
);


/* ==========================================================
   MOTOR CONTROL
   ========================================================== */

let motorTimer = null;

let motorActive = false;


function motorStart(action){

  if(
    motorActive &&
    motorTimer !== null
  ){

    return;

  }


  motorActive = true;

  sendMotor(action);


  motorTimer =
    setInterval(
      function(){

        sendMotor(action);

      },
      250
    );

}


function motorStop(){

  motorActive = false;


  if(motorTimer !== null){

    clearInterval(
      motorTimer
    );

    motorTimer = null;

  }


  sendMotor("stop");

}


function sendMotor(action){

  fetch(
    "/api/motor?action=" +
    encodeURIComponent(action),
    {
      cache:"no-store"
    }
  )

  .then(
    function(response){

      return response.json();

    }
  )

  .then(
    function(data){

      if(data.status){

        document.getElementById(
          "motorStatus"
        ).textContent =
          data.status;

      }

    }
  )

  .catch(
    function(){

      document.getElementById(
        "motorStatus"
      ).textContent =
        "OFFLINE";

    }
  );

}


/* ==========================================================
   PRESS + HOLD MOTOR
   ========================================================== */

document.querySelectorAll(
  "[data-motor]"
).forEach(
  function(button){

    const action =
      button.dataset.motor;


    function start(event){

      event.preventDefault();

      button.classList.add(
        "active"
      );


      if(
        button.setPointerCapture &&
        event.pointerId !== undefined
      ){

        try{

          button.setPointerCapture(
            event.pointerId
          );

        }

        catch(e){}

      }


      motorStart(action);

    }


    function stop(event){

      if(event){

        event.preventDefault();

      }


      button.classList.remove(
        "active"
      );


      motorStop();

    }


    button.addEventListener(
      "pointerdown",
      start
    );


    button.addEventListener(
      "pointerup",
      stop
    );


    button.addEventListener(
      "pointercancel",
      stop
    );


    button.addEventListener(
      "lostpointercapture",
      stop
    );

  }
);


/* ==========================================================
   STOP MOTOR
   ========================================================== */

document.getElementById(
  "stopButton"
).addEventListener(
  "click",
  function(){

    motorStop();

  }
);


/* ==========================================================
   PROBE CONTROL
   ========================================================== */

let probeTimer = null;

let probeActive = false;


function probeStart(action){

  if(
    probeActive &&
    probeTimer !== null
  ){

    return;

  }


  probeActive = true;

  sendProbe(action);


  probeTimer =
    setInterval(
      function(){

        sendProbe(action);

      },
      100
    );

}


function probeStop(){

  probeActive = false;


  if(probeTimer !== null){

    clearInterval(
      probeTimer
    );

    probeTimer = null;

  }


  sendProbe("stop");

}


function sendProbe(action){

  fetch(
    "/api/probe?action=" +
    encodeURIComponent(action),
    {
      cache:"no-store"
    }
  )

  .catch(
    function(){}

  );

}


/* ==========================================================
   PRESS + HOLD PROBE
   ========================================================== */

document.querySelectorAll(
  "[data-probe]"
).forEach(
  function(button){

    const action =
      button.dataset.probe;


    function start(event){

      event.preventDefault();

      button.classList.add(
        "active"
      );


      if(
        button.setPointerCapture &&
        event.pointerId !== undefined
      ){

        try{

          button.setPointerCapture(
            event.pointerId
          );

        }

        catch(e){}

      }


      probeStart(action);

    }


    function stop(event){

      if(event){

        event.preventDefault();

      }


      button.classList.remove(
        "active"
      );


      probeStop();

    }


    button.addEventListener(
      "pointerdown",
      start
    );


    button.addEventListener(
      "pointerup",
      stop
    );


    button.addEventListener(
      "pointercancel",
      stop
    );


    button.addEventListener(
      "lostpointercapture",
      stop
    );

  }
);


/* ==========================================================
   PROBE STOP
   ========================================================== */

document.getElementById(
  "probeStop"
).addEventListener(
  "click",
  function(){

    probeStop();

  }
);


/* ==========================================================
   PROBE POSITION
   ========================================================== */

function updateProbePosition(){

  fetch(
    "/api/probe-position",
    {
      cache:"no-store"
    }
  )

  .then(
    function(response){

      return response.json();

    }
  )

  .then(
    function(data){

      if(
        typeof data.position ===
        "number"
      ){

        document.getElementById(
          "probePosition"
        ).textContent =
          data.position;

      }

    }
  )

  .catch(
    function(){}

  );

}


setInterval(
  updateProbePosition,
  250
);


updateProbePosition();


/* ==========================================================
   SAFETY
   ========================================================== */

window.addEventListener(
  "blur",
  function(){

    motorStop();

    probeStop();

  }
);


document.addEventListener(
  "visibilitychange",
  function(){

    if(document.hidden){

      motorStop();

      probeStop();

    }

  }
);

</script>


</body>

</html>

)rawliteral";


// ============================================================
// OLED
// ============================================================

void showOLED(String line1, String line2 = "") {

  display.clearDisplay();

  display.setTextColor(SH110X_WHITE);

  display.setTextSize(1);

  display.setCursor(0, 0);

  display.println("TERYZON ROVER");

  display.drawLine(
    0,
    12,
    127,
    12,
    SH110X_WHITE
  );

  display.setCursor(0, 25);

  display.println(line1);

  if (line2.length() > 0) {

    display.setCursor(0, 40);

    display.println(line2);

  }

  display.display();

}


// ============================================================
// MOTOR FUNCTIONS
// ============================================================

void setLeftMotor(int speed) {

  speed = constrain(
    speed,
    -255,
    255
  );


  if (speed > 0) {

    digitalWrite(IN1, HIGH);

    digitalWrite(IN2, LOW);

    ledcWrite(
      LEFT_PWM_CHANNEL,
      speed
    );

  }

  else if (speed < 0) {

    digitalWrite(IN1, LOW);

    digitalWrite(IN2, HIGH);

    ledcWrite(
      LEFT_PWM_CHANNEL,
      -speed
    );

  }

  else {

    digitalWrite(IN1, LOW);

    digitalWrite(IN2, LOW);

    ledcWrite(
      LEFT_PWM_CHANNEL,
      0
    );

  }

}


void setRightMotor(int speed) {

  speed = constrain(
    speed,
    -255,
    255
  );


  if (speed > 0) {

    digitalWrite(IN3, HIGH);

    digitalWrite(IN4, LOW);

    ledcWrite(
      RIGHT_PWM_CHANNEL,
      speed
    );

  }

  else if (speed < 0) {

    digitalWrite(IN3, LOW);

    digitalWrite(IN4, HIGH);

    ledcWrite(
      RIGHT_PWM_CHANNEL,
      -speed
    );

  }

  else {

    digitalWrite(IN3, LOW);

    digitalWrite(IN4, LOW);

    ledcWrite(
      RIGHT_PWM_CHANNEL,
      0
    );

  }

}


void stopMotors() {

  setLeftMotor(0);

  setRightMotor(0);

  currentMotor = "STOPPED";

}


void moveForward() {

  setLeftMotor(MOTOR_SPEED);

  setRightMotor(MOTOR_SPEED);

  currentMotor = "FORWARD";

}


void moveBackward() {

  setLeftMotor(-MOTOR_SPEED);

  setRightMotor(-MOTOR_SPEED);

  currentMotor = "BACKWARD";

}


void turnLeft() {

  setLeftMotor(-MOTOR_SPEED);

  setRightMotor(MOTOR_SPEED);

  currentMotor = "LEFT";

}


void turnRight() {

  setLeftMotor(MOTOR_SPEED);

  setRightMotor(-MOTOR_SPEED);

  currentMotor = "RIGHT";

}


// ============================================================
// SERVO FUNCTIONS
// ============================================================

void moveServoDown() {

  if (!servoAvailable) {

    probeMovingDown = false;

    return;

  }


  if (
    millis() - lastServoMove <
    SERVO_STEP_DELAY
  ) {

    return;

  }


  lastServoMove = millis();


  if (
    servoPosition >
    SERVO_DOWN_ANGLE
  ) {

    servoPosition--;

    probeServo.write(
      servoPosition
    );

  }

  else {

    servoPosition =
      SERVO_DOWN_ANGLE;

    probeServo.write(
      servoPosition
    );

    probeMovingDown = false;

  }

}


void moveServoUp() {

  if (!servoAvailable) {

    probeMovingUp = false;

    return;

  }


  if (
    millis() - lastServoMove <
    SERVO_STEP_DELAY
  ) {

    return;

  }


  lastServoMove = millis();


  if (
    servoPosition <
    SERVO_UP_ANGLE
  ) {

    servoPosition++;

    probeServo.write(
      servoPosition
    );

  }

  else {

    servoPosition =
      SERVO_UP_ANGLE;

    probeServo.write(
      servoPosition
    );

    probeMovingUp = false;

  }

}


// ============================================================
// WEB: HOME
// ============================================================

void handleRoot() {

  server.send_P(
    200,
    "text/html",
    INDEX_HTML
  );

}


// ============================================================
// WEB: SVG LOGO
// ============================================================

void handleLogo() {

  server.send_P(
    200,
    "image/svg+xml",
    LOGO_SVG
  );

}


// ============================================================
// WEB: MOTOR
// ============================================================

void handleMotor() {

  String action =
    server.arg("action");


  if (action == "forward") {

    moveForward();

  }

  else if (action == "backward") {

    moveBackward();

  }

  else if (action == "left") {

    turnLeft();

  }

  else if (action == "right") {

    turnRight();

  }

  else {

    stopMotors();

  }


  String json =
    "{\"status\":\"" +
    currentMotor +
    "\"}";


  server.send(
    200,
    "application/json",
    json
  );

}


// ============================================================
// WEB: PROBE
// ============================================================

void handleProbe() {

  String action =
    server.arg("action");


  if (action == "down") {

    probeMovingDown = true;

    probeMovingUp = false;

  }

  else if (action == "up") {

    probeMovingUp = true;

    probeMovingDown = false;

  }

  else {

    probeMovingDown = false;

    probeMovingUp = false;

  }


  server.send(
    200,
    "application/json",
    "{\"ok\":true}"
  );

}


// ============================================================
// WEB: PROBE POSITION
// ============================================================

void handleProbePosition() {

  String json =
    "{\"position\":" +
    String(servoPosition) +
    "}";


  server.send(
    200,
    "application/json",
    json
  );

}


// ============================================================
// WEB: STATUS
// ============================================================

void handleStatus() {

  String json =
    "{"
    "\"motor\":\"" +
    currentMotor +
    "\","
    "\"probe\":" +
    String(servoPosition) +
    ","
    "\"servo\":" +
    String(
      servoAvailable
      ? "true"
      : "false"
    ) +
    "}";


  server.send(
    200,
    "application/json",
    json
  );

}


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(115200);


  // ----------------------------------------------------------
  // OLED
  // ----------------------------------------------------------

  Wire.begin(
    OLED_SDA,
    OLED_SCL
  );


  if (
    !display.begin(
      OLED_ADDRESS,
      true
    )
  ) {

    Serial.println(
      "[OLED] Initialization failed"
    );

  }

  else {

    Serial.println(
      "[OLED] Ready"
    );

    showOLED(
      "Starting system...",
      "Please wait"
    );

  }


  // ----------------------------------------------------------
  // MOTOR PINS
  // ----------------------------------------------------------

  pinMode(
    IN1,
    OUTPUT
  );

  pinMode(
    IN2,
    OUTPUT
  );

  pinMode(
    IN3,
    OUTPUT
  );

  pinMode(
    IN4,
    OUTPUT
  );


  ledcSetup(
    LEFT_PWM_CHANNEL,
    MOTOR_PWM_FREQ,
    MOTOR_PWM_RESOLUTION
  );

  ledcAttachPin(
    ENA,
    LEFT_PWM_CHANNEL
  );


  ledcSetup(
    RIGHT_PWM_CHANNEL,
    MOTOR_PWM_FREQ,
    MOTOR_PWM_RESOLUTION
  );

  ledcAttachPin(
    ENB,
    RIGHT_PWM_CHANNEL
  );


  stopMotors();


  // ----------------------------------------------------------
  // SERVO
  // ----------------------------------------------------------

  probeServo.setPeriodHertz(50);


  bool attached =
    probeServo.attach(
      SERVO_PIN,
      500,
      2400
    );


  if (attached) {

    servoAvailable = true;

    servoPosition =
      SERVO_UP_ANGLE;

    probeServo.write(
      servoPosition
    );

    Serial.println(
      "[SERVO] Attached"
    );

  }

  else {

    servoAvailable = false;

    Serial.println(
      "[SERVO] Attach failed"
    );

  }


  // ----------------------------------------------------------
  // WIFI ACCESS POINT
  // ----------------------------------------------------------

  Serial.println();

  Serial.println(
    "=============================="
  );

  Serial.println(
    "      TERYZON ROVER"
  );

  Serial.println(
    "=============================="
  );


  WiFi.mode(
    WIFI_AP
  );

  WiFi.setSleep(false);


  if (
    !WiFi.softAPConfig(
      local_IP,
      gateway,
      subnet
    )
  ) {

    Serial.println(
      "[WIFI] AP config failed"
    );

  }


  bool apStarted =
    WiFi.softAP(
      AP_SSID,
      AP_PASSWORD
    );


  if (apStarted) {

    Serial.println(
      "[WIFI] Access Point started"
    );

    Serial.print(
      "[WIFI] SSID: "
    );

    Serial.println(
      AP_SSID
    );

    Serial.print(
      "[WIFI] IP: "
    );

    Serial.println(
      WiFi.softAPIP()
    );

  }

  else {

    Serial.println(
      "[WIFI] AP START FAILED"
    );

  }


  // ----------------------------------------------------------
  // WEB ROUTES
  // ----------------------------------------------------------

  server.on(
    "/",
    HTTP_GET,
    handleRoot
  );


  server.on(
    "/logo.svg",
    HTTP_GET,
    handleLogo
  );


  server.on(
    "/api/motor",
    HTTP_GET,
    handleMotor
  );


  server.on(
    "/api/probe",
    HTTP_GET,
    handleProbe
  );


  server.on(
    "/api/probe-position",
    HTTP_GET,
    handleProbePosition
  );


  server.on(
    "/api/status",
    HTTP_GET,
    handleStatus
  );


  // ----------------------------------------------------------
  // 404
  // ----------------------------------------------------------

  server.onNotFound(
    []() {

      server.send(
        404,
        "text/plain",
        "TERYZON: 404"
      );

    }
  );


  // ----------------------------------------------------------
  // START SERVER
  // ----------------------------------------------------------

  server.begin();


  Serial.println(
    "[WEB] Server started"
  );

  Serial.println(
    "[WEB] Open http://192.168.4.1"
  );


  showOLED(
    "SYSTEM READY",
    "192.168.4.1"
  );

}


// ============================================================
// LOOP
// ============================================================

void loop() {

  server.handleClient();


  // ----------------------------------------------------------
  // SERVO MOTION
  // ----------------------------------------------------------

  if (probeMovingDown) {

    moveServoDown();

  }


  if (probeMovingUp) {

    moveServoUp();

  }


  delay(1);

}